#include <stdio.h>
#include "esp_log.h"

void app_main(void)
{
    const char *TAG = "COOKIE_PROJECT";

    // 🍪 จำนวนคุกกี้และเพื่อน
    int total_cookies = 12;
    int friends = 4;

    // ✅ ตรวจสอบว่าเพื่อนมากกว่า 0 เพื่อป้องกันหารด้วยศูนย์
    if (friends > 0) {
        int cookies_per_person = total_cookies / friends;
        int remaining_cookies = total_cookies % friends;

        // แสดงผลลัพธ์หลัก
        ESP_LOGI(TAG, "=== คุกกี้แบ่งกัน ===");
        ESP_LOGI(TAG, "คุกกี้ทั้งหมด: %d ชิ้น", total_cookies);
        ESP_LOGI(TAG, "จำนวนเพื่อน: %d คน", friends);
        ESP_LOGI(TAG, "แต่ละคนได้: %d ÷ %d = %d ชิ้น", 
                 total_cookies, friends, cookies_per_person);
        ESP_LOGI(TAG, "เศษที่เหลือ: %d ชิ้น", remaining_cookies);

        // 🧪 แบบฝึกหัดที่ 2: ตรวจสอบว่าหารลงตัวไหม
        if (remaining_cookies == 0) {
            ESP_LOGI(TAG, "✅ หารลงตัว! ทุกคนได้เท่ากัน");
        } else {
            ESP_LOGI(TAG, "⚠️ หารไม่ลงตัว! เหลือ %d ชิ้น", remaining_cookies);
        }
    } else {
        ESP_LOGI(TAG, "❌ ไม่สามารถหารด้วย 0 ได้!");
    }

    // 🔍 แบบฝึกหัดที่ 3: หาจำนวนคนที่หารคุกกี้ลงตัว
    int cookies = 30;
    ESP_LOGI(TAG, "🔍 คุกกี้ %d ชิ้น หารลงตัวกับ:", cookies);

    for (int people = 1; people <= 10; people++) {
        if (cookies % people == 0) {
            ESP_LOGI(TAG, "   ✅ %d คน → คนละ %d ชิ้น", 
                     people, cookies / people);
        }
    }
}
